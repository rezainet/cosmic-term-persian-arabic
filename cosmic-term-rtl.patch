+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Paragraph direction of terminal lines and the mapping between cells and glyphs.
+//!
+//! Every line is handed to the shaper as a left-to-right paragraph, so glyphs always stay on
+//! the cell grid. A line that should read right-to-left is wrapped in an RTL isolate instead,
+//! which mirrors its content within the row.
+
+use cosmic_text::{Buffer, FeatureTag, FontFeatures};
+use std::sync::OnceLock;
+use unicode_bidi::BidiClass;
+
+/// LEFT-TO-RIGHT ISOLATE, the prefix of every line.
+pub const LRI: char = '\u{2066}';
+/// RIGHT-TO-LEFT ISOLATE, replaces [`LRI`] on right-to-left lines.
+const RLI: char = '\u{2067}';
+/// RIGHT-TO-LEFT MARK, keeps the trailing blank cells inside the RTL run.
+const RLM: char = '\u{200F}';
+
+/// Default for [`ltr_word_limit`].
+const LTR_WORD_LIMIT: u32 = 5;
+
+/// Font features of terminal text. `rtla` is switched off: the shaper already mirrors brackets
+/// in right-to-left runs, and a font that swaps them in `rtla` as well (Menlo and the fonts made
+/// from it, like Meslo) would turn them back.
+pub fn font_features() -> FontFeatures {
+    let mut features = FontFeatures::new();
+    features.disable(FeatureTag::new(b"rtla"));
+    features
+}
+
+/// Whether the direction of a line is detected from its content.
+/// Set `COSMIC_TERM_BIDI_AUTODETECT=0` to force every line to LTR.
+pub fn autodetect() -> bool {
+    static AUTODETECT: OnceLock<bool> = OnceLock::new();
+    *AUTODETECT.get_or_init(|| {
+        !matches!(
+            std::env::var("COSMIC_TERM_BIDI_AUTODETECT").as_deref(),
+            Ok("0" | "false" | "off")
+        )
+    })
+}
+
+/// A line with RTL text stays left-to-right when it starts with more than this many
+/// left-to-right words. Set with `COSMIC_TERM_BIDI_LTR_WORDS`.
+pub fn ltr_word_limit() -> u32 {
+    static LIMIT: OnceLock<u32> = OnceLock::new();
+    *LIMIT.get_or_init(|| {
+        std::env::var("COSMIC_TERM_BIDI_LTR_WORDS")
+            .ok()
+            .and_then(|value| value.trim().parse().ok())
+            .unwrap_or(LTR_WORD_LIMIT)
+    })
+}
+
+enum CharKind {
+    Rtl,
+    Ltr,
+    Space,
+    Neutral,
+}
+
+fn char_kind(c: char) -> CharKind {
+    if c.is_ascii() {
+        return if c.is_ascii_alphanumeric() {
+            CharKind::Ltr
+        } else if c == ' ' || c == '\t' {
+            CharKind::Space
+        } else {
+            CharKind::Neutral
+        };
+    }
+    // Private use characters are icons in terminal fonts, not words
+    if matches!(c, '\u{E000}'..='\u{F8FF}' | '\u{F0000}'..='\u{10FFFF}') {
+        return CharKind::Neutral;
+    }
+    match unicode_bidi::bidi_class(c) {
+        BidiClass::R | BidiClass::AL => CharKind::Rtl,
+        BidiClass::L => CharKind::Ltr,
+        BidiClass::WS => CharKind::Space,
+        _ => CharKind::Neutral,
+    }
+}
+
+/// Decides the direction of one line while its cells are read in logical order.
+///
+/// A line is right-to-left when it has RTL text, unless more than `limit` left-to-right words
+/// (runs of cells without a blank that hold a letter or an ASCII digit) come before it.
+#[derive(Default)]
+pub struct DirScan {
+    has_rtl: bool,
+    leading_ltr_words: u32,
+    in_word: bool,
+}
+
+impl DirScan {
+    pub fn push(&mut self, c: char) {
+        if self.has_rtl {
+            return;
+        }
+        match char_kind(c) {
+            CharKind::Rtl => self.has_rtl = true,
+            CharKind::Ltr => {
+                if !self.in_word {
+                    self.in_word = true;
+                    self.leading_ltr_words += 1;
+                }
+            }
+            CharKind::Space => self.in_word = false,
+            CharKind::Neutral => {}
+        }
+    }
+
+    pub fn has_rtl(&self) -> bool {
+        self.has_rtl
+    }
+
+    pub fn is_rtl(&self, limit: u32) -> bool {
+        self.has_rtl && self.leading_ltr_words <= limit
+    }
+}
+
+/// Bidirectional state of one visible line.
+#[derive(Clone, Debug, Default)]
+pub struct LineBidi {
+    /// The line is mirrored (laid out as a right-to-left paragraph).
+    pub rtl: bool,
+    /// Byte offset in the line text of every column, empty when the line has no RTL text and
+    /// columns map to positions directly. The spacer of a wide character shares its offset.
+    pub cell_starts: Vec<u32>,
+}
+
+impl LineBidi {
+    /// Columns covered by the bytes `start..end` of the line text: first column and count.
+    pub fn columns(&self, start: usize, end: usize) -> Option<(usize, usize)> {
+        let start = u32::try_from(start).ok()?;
+        let end = u32::try_from(end).ok()?;
+        // Last column that begins at or before `start`, then the first one sharing its offset
+        let containing = self
+            .cell_starts
+            .partition_point(|&s| s <= start)
+            .checked_sub(1)?;
+        let offset = self.cell_starts[containing];
+        let first = self.cell_starts.partition_point(|&s| s < offset);
+        let after = self.cell_starts.partition_point(|&s| s < end);
+        Some((first, after.saturating_sub(first).max(1)))
+    }
+}
+
+/// Finish the text of a line that was started with [`LRI`]. For a right-to-left line the prefix
+/// is swapped for RLI (same UTF-8 length, so attribute spans stay valid) and RLM is appended.
+pub fn finish_line_text(text: &mut String, rtl: bool) {
+    if rtl && text.starts_with(LRI) {
+        text.replace_range(..LRI.len_utf8(), RLI.encode_utf8(&mut [0; 4]));
+        text.push(RLM);
+    }
+}
+
+/// Position inside a glyph as a fraction of its columns, in logical order.
+pub fn logical_fraction(x: f32, glyph_x: f32, glyph_w: f32, glyph_rtl: bool) -> f32 {
+    let fraction = ((x - glyph_x) / glyph_w).clamp(0.0, 0.999);
+    if glyph_rtl { 0.999 - fraction } else { fraction }
+}
+
+/// Column under the horizontal position `x` on the visible line `row`, in logical order.
+/// The fractional part is the position inside the cell, also in logical order.
+pub fn logical_col(
+    buffer: &Buffer,
+    line: Option<&LineBidi>,
+    row: usize,
+    x: f32,
+    cell_width: f32,
+) -> f32 {
+    let direct = x / cell_width;
+    let Some(line) = line else {
+        return direct;
+    };
+    if line.cell_starts.is_empty() {
+        return direct;
+    }
+    let Some(run) = buffer.layout_runs().nth(row) else {
+        return direct;
+    };
+    for glyph in run.glyphs {
+        if glyph.w <= 0.0 || x < glyph.x || x >= glyph.x + glyph.w {
+            continue;
+        }
+        let Some((first, count)) = line.columns(glyph.start, glyph.end) else {
+            continue;
+        };
+        let fraction = logical_fraction(x, glyph.x, glyph.w, glyph.level.is_rtl());
+        return first as f32 + fraction * count as f32;
+    }
+    // Outside of the text: the right edge of a mirrored line is its first column
+    if line.rtl { 0.0 } else { direct }
+}
+
+/// Position and width of the cell at `col` on the visible line `row`, and whether it reads
+/// right-to-left. `None` when the line has no RTL text and cells map to positions directly.
+pub fn cell_position(
+    buffer: &Buffer,
+    line: &LineBidi,
+    row: usize,
+    col: usize,
+) -> Option<(f32, f32, bool)> {
+    let start = *line.cell_starts.get(col)? as usize;
+    let run = buffer.layout_runs().nth(row)?;
+    for glyph in run.glyphs {
+        if glyph.w <= 0.0 || start < glyph.start || start >= glyph.end {
+            continue;
+        }
+        let (first, count) = line.columns(glyph.start, glyph.end)?;
+        let cell_w = glyph.w / count as f32;
+        let index = col.saturating_sub(first).min(count - 1) as f32;
+        let rtl = glyph.level.is_rtl();
+        let x = if rtl {
+            glyph.x + glyph.w - (index + 1.0) * cell_w
+        } else {
+            glyph.x + index * cell_w
+        };
+        return Some((x, cell_w, rtl));
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scan(line: &str) -> DirScan {
+        let mut scan = DirScan::default();
+        for c in line.chars() {
+            scan.push(c);
+        }
+        scan
+    }
+
+    #[test]
+    fn persian_first_is_rtl() {
+        assert!(scan("من از terminal استفاده می‌کنم").is_rtl(5));
+        assert!(scan("● فایل ~/.config را باز کن").is_rtl(5));
+    }
+
+    #[test]
+    fn few_leading_english_words_stay_rtl() {
+        assert!(scan("● Terminal یک interface متنی است").is_rtl(5));
+        assert!(scan("The file is ready و همه چیز درست است (OK).").is_rtl(5));
+        assert!(scan("one two three four five فارسی").is_rtl(5));
+    }
+
+    #[test]
+    fn many_leading_english_words_are_ltr() {
+        let line = scan("one two three four five six فارسی");
+        assert!(line.has_rtl());
+        assert!(!line.is_rtl(5));
+        assert!(!scan("-rw-r--r-- 1 user user 1024 Sep 29 10:30 گزارش.txt").is_rtl(5));
+    }
+
+    #[test]
+    fn no_rtl_text_is_ltr() {
+        let line = scan("ls -la /home/user   # plain LTR line");
+        assert!(!line.has_rtl());
+        assert!(!line.is_rtl(5));
+        assert!(!scan("").is_rtl(5));
+        assert!(!scan("│ ● 2026-09-29 │").is_rtl(5));
+    }
+
+    #[test]
+    fn words_are_split_by_blanks_only() {
+        // One word each: a path, a dashed name, a bracketed call
+        assert!(scan("~/.config/cosmic/font_name cosmic-term Bash(echo فارسی").is_rtl(3));
+        assert!(!scan("a b c d فارسی").is_rtl(3));
+        // Symbols and icons are not words
+        assert!(scan("● │ → \u{E0B0} -- فارسی").is_rtl(0));
+        // Persian digits are not left-to-right words
+        assert!(scan("۱۲ ۳۴ ۵۶ فارسی").is_rtl(0));
+    }
+
+    #[test]
+    fn finish_swaps_prefix_and_keeps_length() {
+        let mut text = String::from(LRI);
+        text.push_str("abc");
+        let before = text.len();
+        finish_line_text(&mut text, false);
+        assert_eq!(text.len(), before);
+        assert!(text.starts_with(LRI));
+
+        finish_line_text(&mut text, true);
+        assert!(text.starts_with(RLI));
+        assert!(text.ends_with(RLM));
+        assert_eq!(text.len(), before + RLM.len_utf8());
+        assert_eq!(&text[LRI.len_utf8()..before], "abc");
+    }
+
+    #[test]
+    fn columns_of_glyphs() {
+        // prefix is 3 bytes; "aب" + wide char (3 bytes, 2 columns) + "c"
+        // columns:            0    1    2    3(spacer) 4
+        let line = LineBidi {
+            rtl: true,
+            cell_starts: vec![3, 4, 6, 6, 9],
+        };
+        assert_eq!(line.columns(3, 4), Some((0, 1)));
+        assert_eq!(line.columns(4, 6), Some((1, 1)));
+        // Wide character covers its spacer
+        assert_eq!(line.columns(6, 9), Some((2, 2)));
+        assert_eq!(line.columns(9, 10), Some((4, 1)));
+        // Ligature over two cells
+        assert_eq!(line.columns(3, 6), Some((0, 2)));
+        // A mark inside a cell belongs to that cell
+        assert_eq!(line.columns(5, 6), Some((1, 1)));
+        // The prefix is before every column
+        assert_eq!(line.columns(0, 3), None);
+        assert_eq!(LineBidi::default().columns(3, 4), None);
+    }
+
+    /// Lay out lines of cells like `Terminal::update` does
+    fn layout(lines: &[&str], columns: usize) -> (Buffer, Vec<LineBidi>, f32) {
+        use cosmic_text::{
+            Attrs, AttrsList, BufferLine, Family, FontSystem, LineEnding, Metrics, Shaping, Wrap,
+        };
+
+        let mut font_system = FontSystem::new();
+        // BIDI_TEST_FONT picks the font, e.g. one that has an `rtla` feature
+        let family = match std::env::var("BIDI_TEST_FONT") {
+            Ok(name) => Family::Name(Box::leak(name.into_boxed_str())),
+            Err(_) => Family::Monospace,
+        };
+        let attrs = Attrs::new().family(family).font_features(font_features());
+        let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+        buffer.set_wrap(Wrap::None);
+        buffer.set_text(" ", &attrs, Shaping::Advanced, None);
+        let cell_width = buffer.line_layout(&mut font_system, 0).unwrap()[0].w;
+        buffer.set_monospace_width(Some(cell_width));
+        buffer.set_size(Some(cell_width * columns as f32 + 3.0), Some(20.0 * 50.0));
+        buffer.lines.clear();
+
+        let mut line_bidi = Vec::new();
+        for line in lines {
+            let mut text = String::from(LRI);
+            let mut scan = DirScan::default();
+            let mut cell_starts = Vec::new();
+            let mut cells = 0;
+            for c in line.chars().chain(std::iter::repeat(' ')) {
+                // Zero width characters share the cell of the character before them
+                let zero_width = matches!(c, '\u{200C}' | '\u{200D}' | '\u{064B}'..='\u{065F}');
+                if !zero_width {
+                    if cells == columns {
+                        break;
+                    }
+                    cells += 1;
+                    cell_starts.push(text.len() as u32);
+                    scan.push(c);
+                }
+                text.push(c);
+            }
+            let rtl = scan.is_rtl(LTR_WORD_LIMIT);
+            finish_line_text(&mut text, rtl);
+            if !scan.has_rtl() {
+                cell_starts.clear();
+            }
+            line_bidi.push(LineBidi { rtl, cell_starts });
+            buffer.lines.push(BufferLine::new(
+                text,
+                LineEnding::default(),
+                AttrsList::new(&attrs),
+                Shaping::Advanced,
+            ));
+        }
+        buffer.shape_until_scroll(&mut font_system, true);
+        (buffer, line_bidi, cell_width)
+    }
+
+    const COLUMNS: usize = 60;
+
+    /// The column found under the middle of every cell is that cell
+    fn assert_round_trip(buffer: &Buffer, line: &LineBidi, row: usize, cell_width: f32) {
+        for col in 0..COLUMNS {
+            let position = cell_position(buffer, line, row, col);
+            assert_eq!(position.is_some(), !line.cell_starts.is_empty());
+            let (x, w, _) = position.unwrap_or((col as f32 * cell_width, cell_width, false));
+            let found = logical_col(buffer, Some(line), row, x + w / 2.0, cell_width);
+            assert_eq!(found as usize, col, "row {row} column {col} at x {x}");
+        }
+    }
+
+    #[test]
+    fn mouse_finds_the_cell_under_it() {
+        let lines = [
+            "plain english row",
+            "من از terminal استفاده می‌کنم و English قاطی نمی‌شود.",
+            "The file is ready و همه چیز درست است (OK).",
+            "one two three four five six seven فارسی در آخر",
+            "● فایل ~/.config/cosmic را باز کن 42",
+            "سلام کلاه الله لا (lam-alef) |end",
+        ];
+        let (buffer, line_bidi, cell_width) = layout(&lines, COLUMNS);
+        assert_eq!(
+            line_bidi.iter().map(|line| line.rtl).collect::<Vec<_>>(),
+            [false, true, true, false, true, true]
+        );
+        for (row, line) in line_bidi.iter().enumerate() {
+            assert_round_trip(&buffer, line, row, cell_width);
+        }
+    }
+
+    #[test]
+    fn mirrored_line_starts_at_the_right() {
+        let (buffer, line_bidi, cell_width) = layout(&["The file و همه"], COLUMNS);
+        let line = &line_bidi[0];
+        let run = buffer.layout_runs().next().unwrap();
+        let width = run
+            .glyphs
+            .iter()
+            .fold(0.0_f32, |width, glyph| width.max(glyph.x + glyph.w));
+        // "The file" is one left-to-right run at the right edge, blank cells are at the left
+        let (x, w, _) = cell_position(&buffer, line, 0, 7).unwrap();
+        assert!((x + w - width).abs() < 0.5, "run ends at {}, row is {width}", x + w);
+        let (x, _, rtl) = cell_position(&buffer, line, 0, 0).unwrap();
+        assert!(!rtl);
+        assert!((x - (width - 8.0 * cell_width)).abs() < 0.5, "first cell at {x}");
+        let (x, _, _) = cell_position(&buffer, line, 0, COLUMNS - 1).unwrap();
+        assert!(x.abs() < 0.5, "last cell at {x}");
+        // "The" keeps its reading order: T is left of e
+        let (t, _, _) = cell_position(&buffer, line, 0, 0).unwrap();
+        let (e, _, _) = cell_position(&buffer, line, 0, 2).unwrap();
+        assert!(t < e);
+        // Persian letters read right-to-left: و is right of ه (first letter of همه)
+        let (vav, _, vav_rtl) = cell_position(&buffer, line, 0, 9).unwrap();
+        let (he, _, _) = cell_position(&buffer, line, 0, 11).unwrap();
+        assert!(vav_rtl);
+        assert!(vav > he);
+        // Clicking the left half of a Persian letter is its logical right side
+        let col = logical_col(&buffer, Some(line), 0, vav + 1.0, cell_width);
+        assert_eq!(col as usize, 9);
+        assert!(col.fract() > 0.5);
+    }
+
+    #[test]
+    fn brackets_are_mirrored_once() {
+        let lines = ["abc (OK) def", "فارسی است (OK).", "فارسی (فارسی) فارسی"];
+        let (buffer, line_bidi, _) = layout(&lines, 40);
+        assert_eq!(
+            line_bidi.iter().map(|line| line.rtl).collect::<Vec<_>>(),
+            [false, true, true]
+        );
+        // Glyph and position of the first `c` on every line
+        let find = |c: char| -> Vec<(u16, f32)> {
+            buffer
+                .layout_runs()
+                .map(|run| {
+                    let glyph = run
+                        .glyphs
+                        .iter()
+                        .find(|glyph| run.text[glyph.start..glyph.end].starts_with(c))
+                        .unwrap();
+                    (glyph.glyph_id, glyph.x)
+                })
+                .collect()
+        };
+        let open = find('(');
+        let close = find(')');
+        assert_ne!(open[0].0, close[0].0);
+        assert!(open[0].1 < close[0].1);
+        for row in 1..lines.len() {
+            // The opening bracket is at the right and drawn with the closing shape
+            assert!(open[row].1 > close[row].1, "row {row}");
+            assert_eq!(open[row].0, close[0].0, "row {row}");
+            assert_eq!(close[row].0, open[0].0, "row {row}");
+        }
+    }
+
+    #[test]
+    fn fraction_follows_glyph_direction() {
+        assert!(logical_fraction(10.0, 10.0, 8.0, false) < 0.5);
+        assert!(logical_fraction(17.0, 10.0, 8.0, false) > 0.5);
+        assert!(logical_fraction(10.0, 10.0, 8.0, true) > 0.5);
+        assert!(logical_fraction(17.0, 10.0, 8.0, true) < 0.5);
+        let f = logical_fraction(18.0, 10.0, 8.0, true);
+        assert!((0.0..1.0).contains(&f));
+    }
+}
